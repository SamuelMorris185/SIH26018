# ==============================================================================
# SIH26018 Intelligent Land Record Digitization and Validation System
# Backend Environment Configuration Template (.env.example)
#
# Copy this file to `backend/.env` for local development.
# WARNING: NEVER commit the actual `backend/.env` file or production secrets to Git!
# ==============================================================================

# Application Metadata & Server Networking
APP_NAME="SIH26018 Intelligent Land Record System"
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Connectivity (PostgreSQL with asyncpg)
# Default Docker compose instance: postgres:postgres@localhost:5432/sih26018_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih26018_db

# CORS & Frontend Origins (JSON array of allowed origins)
FRONTEND_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication & Security
# WARNING: Outside 'development', JWT_SECRET_KEY must be a unique, cryptographically
# secure random string of at least 32 bytes (256 bits).
JWT_SECRET_KEY=dev_sih26018_secret_key_change_in_production_min32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OCR Extraction Engine Configuration
# Supported options:
#   - TESSERACT : Live local native Tesseract OCR engine (Recommended for hackathon demo)
#   - MOCK      : Offline deterministic mock provider (for fast tests without Tesseract binary)
OCR_ENGINE=TESSERACT

# Path to Tesseract executable (Optional).
# If omitted or None, the application automatically detects 'tesseract' on the system PATH.
# Example Windows manual paths:
# TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD_PATH=C:\Users\<username>\scoop\shims\tesseract.exe
# TESSERACT_CMD_PATH=

# Validation & Confidence Thresholds [0.0 - 1.0]
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
CONFIDENCE_THRESHOLD_LOW=0.60
AREA_TOLERANCE_HECTARES=0.01

# Phase 9: Optional AI Intelligence Layer (Gemini Assistance)
# AI_ENABLED: Set to true to enable optional Gemini 3.8 Flash interpretation of OCR text.
# If disabled, missing API key, or network error, pipeline automatically falls back to deterministic extraction.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=30

# Storage & Upload Constraints
# Relative paths resolve against backend/, regardless of current working directory.
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=["application/pdf","image/png","image/jpeg","image/tiff","application/octet-stream"]
ALLOWED_EXTENSIONS=[".pdf",".png",".jpg",".jpeg",".tiff",".tif"]
