APP_NAME=SIH26018 Intelligent Land Record System
APP_ENV=development
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sih26018_db
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Authentication & Security
# WARNING: Change JWT_SECRET_KEY in production to a secure random string of at least 32 bytes
JWT_SECRET_KEY=dev_sih26018_secret_key_change_in_production_min32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Phase 5: Pluggable OCR & Confidence Engine
# Supported options: MOCK (offline/simulated), TESSERACT (local native engine)
OCR_ENGINE=MOCK
# TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
CONFIDENCE_THRESHOLD_HIGH=0.85
CONFIDENCE_THRESHOLD_MEDIUM=0.60
CONFIDENCE_THRESHOLD_LOW=0.60
AREA_TOLERANCE_HECTARES=0.01
