# Dependencies
node_modules/
**/node_modules/

# Python virtual environments
venv/
**/venv/
.venv/
**/.venv/

# Environment files
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Python cache and compiled files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend build output
dist/
**/dist/
build/
**/build/

# Coverage and test reports
.coverage
htmlcov/

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Runtime document storage and generated reports (fixtures belong under backend/tests/fixtures)
uploads/
backend/uploads/
**/uploads/
reports/
backend/reports/
**/reports/

# Generated runtime PDFs (preserve test fixtures)
*.pdf
!backend/tests/fixtures/**/*.pdf

